# systemd unit for the Python murmurd. Install to
# /etc/systemd/system/murmurd.service.
#
# Setup on the Pi (copy the repo to /opt/murmur, then install with uv):
#   sudo apt install -y bluez python3-dev build-essential libdbus-1-dev pkg-config
#   sudo useradd --system --create-home --shell /bin/bash murmur
#   sudo usermod -aG bluetooth murmur
#   # as the murmur user, install with uv (creates /opt/murmur/daemon/.venv):
#   sudo -u murmur sh -c 'cd /opt/murmur/daemon && uv sync'
#   # (no uv? fall back to: python3 -m venv .venv && .venv/bin/pip install .)
#
# Pair a phone first (as the murmur user, so the PSK lands in its config dir):
#   sudo -u murmur /opt/murmur/daemon/.venv/bin/murmurd \
#        --config-dir /home/murmur/.config/murmur --pair
#
#   sudo systemctl enable --now murmurd

[Unit]
Description=murmur BLE remote shell daemon
After=bluetooth.target
Requires=bluetooth.target

[Service]
Type=simple
User=murmur
Group=murmur
# Runs the shell as the murmur user — NOT root. Adjust --shell as needed.
# Points at the venv's console script directly, so uv isn't needed at runtime.
ExecStart=/opt/murmur/daemon/.venv/bin/murmurd --config-dir /home/murmur/.config/murmur --shell /bin/bash
Restart=on-failure
RestartSec=2

# Hardening
# NOTE: this blocks the agent from running `sudo`. NoNewPrivileges sets the
# kernel no_new_privs bit, under which setuid binaries (sudo) can't elevate; and
# ProtectSystem/ProtectHome make the filesystem read-only. To let the agent run
# privileged commands, drop NoNewPrivileges and relax ProtectSystem/ProtectHome
# (ProtectSystem=no / ProtectHome=no), add a sudoers entry for this user, and
# set the sudo password in the app. This effectively grants root to anyone who
# can pair a phone — see daemon/README.md → "Privileges & sudo".
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/home/murmur/.config/murmur
ProtectHome=read-only
PrivateTmp=true

[Install]
WantedBy=multi-user.target
